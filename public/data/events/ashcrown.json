{
  "map": "ashcrown",
  "events": [
    {
      "id": "leave_home",
      "trigger": "touch",
      "when": [{ "story": "leave_home", "is": "next" }],
      "commands": [
        { "type": "message", "talk": [{ "lines": ["お～い！！"] }], "style": "window" },
        { "type": "turn", "target": "player", "to": "up" },
        { "type": "shot", "id": "event010201_camera01", "wait": false },
        {
          "type": "place",
          "target": "npc:grandpaNpc",
          "at": { "x": "player", "y": 10, "z": 0 },
          "face": "left"
        },
        {
          "type": "move",
          "target": "npc:grandpaNpc",
          "to": { "x": "player", "y": 10, "z": 1 },
          "first": "upDown"
        },
        { "type": "wait", "ms": 200 },
        {
          "type": "portrait",
          "slot": "left",
          "who": "grandpa",
          "face": "normal",
          "id": "じいちゃんイラスト",
          "flip": true
        },
        { "type": "portrait", "slot": "right", "who": "meina", "face": "talk" },
        {
          "type": "message",
          "talk": [
            { "who": "grandpa", "lines": ["待て！！", "・・・・・・・", "ついに行くのか？"] },
            { "who": "meina", "lines": ["う～ん、どうしようかな", "もう行こうかな？"] }
          ]
        },
        {
          "type": "choice",
          "choices": ["はい", "いいえ"],
          "cancel": 1,
          "branches": [
            [
              {
                "type": "message",
                "talk": [
                  {
                    "who": "grandpa",
                    "lines": ["ついに旅立ちじゃな・・・", "近頃、シュラン族が増えている", "見たら逃げるんじゃよ", "助からないかもしれんからな"]
                  },
                  { "who": "meina", "lines": ["（いや今日は普通に帰るけど）"] }
                ]
              }
            ],
            [
              {
                "type": "message",
                "talk": [
                  {
                    "who": "grandpa",
                    "lines": ["あまり遠くに行きすぎんようにな", "そうそう、最近シュラン族が増えている", "絶対逃げるんじゃよ"]
                  },
                  { "who": "meina", "lines": ["おっけー"] }
                ]
              }
            ]
          ]
        },
        {
          "type": "move",
          "target": "npc:grandpaNpc",
          "to": { "x": -6, "y": 10, "z": -1 },
          "first": "upDown"
        },
        {
          "type": "move",
          "target": "npc:grandpaNpc",
          "to": { "x": 6, "y": 10, "z": -1 },
          "first": "leftRight",
          "wait": false
        },
        { "type": "shot", "id": "event010201_camera02" },
        { "type": "wait", "ms": 1000 },
        { "type": "hide", "target": "npc:grandpaNpc" },
        { "type": "story", "done": "leave_home" }
      ],
      "kind": "scenario"
    },
    {
      "id": "leave_home_walk",
      "trigger": "touch",
      "when": [{ "story": "leave_home", "is": "next" }],
      "commands": [
        { "type": "portrait", "slot": "right", "who": "meina", "face": "talk" },
        {
          "type": "message",
          "talk": [
            {
              "who": "meina",
              "lines": ["ちょっと山を下りて散策しようかな", "そういえば最近シュラン族が多いんだよね", "勝てそうにないから気を付けよう・・・。"]
            }
          ]
        },
        { "type": "portrait", "slot": "right", "hide": true },
        { "type": "story", "done": "leave_home" }
      ],
      "kind": "scenario"
    },
    {
      "id": "talk_whiteCat",
      "npc": "whiteCat",
      "trigger": "action",
      "commands": [
        {
          "type": "message",
          "style": "bubble",
          "talk": [
            { "lines": ["我が力を欲するか？", "・・・・・・・", "我が力いらない？"] },
            { "who": "meina", "lines": ["えぇ？", "う～ん、どうしようかな", "やっぱりいらねっす・・・"] },
            { "lines": ["そんなぁ・・・"] }
          ]
        }
      ],
      "kind": "talk"
    },
    {
      "id": "talk_blackCat",
      "npc": "blackCat",
      "trigger": "action",
      "commands": [
        {
          "type": "message",
          "style": "bubble",
          "talk": [{ "lines": ["こちらは体験版です"] }, { "lines": ["・・・"] }, { "lines": ["製品版も買ってね！"] }]
        }
      ],
      "kind": "talk"
    },
    {
      "id": "Chest_Map0102",
      "kind": "click",
      "trigger": "action",
      "commands": [
        {
          "type": "if",
          "when": { "self": "開けた" },
          "then": [{ "type": "message", "talk": [{ "lines": ["からっぽだ。"] }] }],
          "else": [
            { "type": "playSe", "key": "chest" },
            { "type": "getItem", "id": "やくそう", "count": 2 },
            { "type": "layer", "id": "Chest_Map0102_閉", "shown": false },
            { "type": "layer", "id": "Chest_Map0102_開", "shown": true },
            { "type": "setSelfSwitch", "key": "開けた", "value": true },
            { "type": "message", "talk": [{ "lines": ["{アイテム} を 手に入れた！"] }] }
          ]
        }
      ]
    }
  ],
  "mapMoves": [
    {
      "object": "obj_1",
      "to": [{ "map": "home", "at": { "x": 5, "y": 0, "z": 3 }, "px": { "x": 0, "z": -9 }, "face": "up" }]
    },
    {
      "object": "obj_2",
      "to": [{ "map": "forest_mansion", "at": { "x": -17, "y": 0, "z": -28 }, "face": "down" }]
    }
  ]
}
