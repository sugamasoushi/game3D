          "at": { "x": 9, "y": 0, "z": -7 },
          "face": "down"
        },
        {
          "type": "place",
          "target": "npc:soldier_junior01",
          "at": { "x": -2, "y": 0, "z": 24 },
          "face": "down"
        },
        { "type": "place", "target": "player", "at": { "x": -4, "y": 0, "z": 23 }, "face": "up" },
        {
          "type": "place",
          "target": "party:lamy",
          "at": { "x": -3, "y": 0, "z": 24 },
