          "talk": [
            { "who": "meina", "lines": ["う～ん、服がボロボロに", "なってきたなぁ"] },
            { "who": "meina", "lines": ["そろそろ新調しないとなぁ", "お金無いけど・・・"] }
          ]
        }
      ],
      "kind": "click"
    },
    {
      "id": "click0001",
      "trigger": "action",
      "commands": [
        {
          "type": "message",
          "style": "bubble",
          "talk": [
            { "who": "meina", "lines": ["新しく覚える魔法は何が良いかな？", "やっぱり生活に役立つ方が良いかな"] },
            { "who": "meina", "lines": ["・・・・・また今度！！"] }
          ]
        }
      ],
      "kind": "click"
    },
    {
      "id": "talk_grandpa",
      "npc": "grandpaNpc",
      "trigger": "action",
      "commands": [
        {
          "type": "if",
          "when": { "story": "lamy_visits", "is": "notDone" },
          "then": [
            {
              "type": "message",
              "talk": [
                { "who": "meina", "lines": ["今日は何食べようかな～♪"] },
                { "who": "grandpa", "lines": ["ちゃんと野菜を食べやさい"] },
                { "who": "meina", "lines": ["アツアツのから揚げ・・・"] },
                { "who": "grandpa", "lines": ["若鳥じゃないからまずいじゃろうて"] },
                { "who": "meina", "lines": ["冗談だってば！"] }
              ],
              "style": "bubble"
            }
          ],
          "else": [
            {
              "type": "message",
              "talk": [{ "who": "grandpa", "lines": ["気を付けるんじゃぞ"] }],
              "style": "bubble"
            }
          ]
        }
      ],
      "kind": "talk"
    },
    {
      "id": "breakfast",
      "kind": "scenario",
      "trigger": "touch",
      "commands": [
        {
          "type": "scroll",
          "speed": 800,
          "dim": 0.5,
          "lines": [
            "昔々（？）",
            "ある山奥に一人の魔術師見習い「メイナ」が暮らしていました。",
            "",
            "物心付いた頃から家具付きの家に住んでおり、キッチンも寝室も別々でした。",
            "謎の鶏に育てられ、基本的な生活習慣は身についており、最近は魚料理を夢見ています。",
            "山奥ですからね。",
            "",
            "グローバルでスタンダードな言語を習得しているが、読書は苦手。",
            "基礎学力はそこそこ高いが世間知らず。",
            "この間も食料調達に町へ出かけた際、道中で狩った熊をそのまま売りつけてしまったとか。",
            "",
            "魔術を勉強しており、その習得の速さは鶏もトサカを巻く程。",
            "将来は大魔導士になると先月まで豪語していたが、最近は魔法戦士がかっこいいと思っている。",
            "長続きしないタイプ。",
            "",
            "今日は山を下りて近くを探索するようだ。"
          ]
        },
        { "type": "portrait", "slot": "right", "who": "meina", "face": "talk" },
        {
          "type": "message",
          "talk": [{ "who": "meina", "lines": ["ごちそうさまでした。", "う～ん、そろそろ食料が尽きてきたし", "今日は狩にでも行くかな"] }],
          "style": "window"
        },
        { "type": "story", "done": "breakfast" }
      ],
      "when": [{ "story": "breakfast", "is": "next" }]
    },
    {
      "id": "lamy_visits",
      "trigger": "touch",
      "when": [{ "story": "lamy_visits", "is": "next" }],
      "commands": [
        { "type": "playSe", "key": "punch" },
        { "type": "shot", "id": "impact", "wait": false },
        {
          "type": "place",
          "target": "npc:lamyNPC",
          "at": { "x": "player", "y": "player", "z": 3 },
          "face": "up"
        },
        { "type": "move", "target": "player", "dir": "up", "cells": 2, "slide": true, "speed": 10 },
        { "type": "turn", "target": "player", "to": "down" },
        { "type": "portrait", "slot": "left", "who": "lamyNPC", "face": "talk" },
        { "type": "portrait", "slot": "right", "who": "meina", "face": "talk" },
        {
          "type": "message",
          "talk": [
            { "who": "lamyNPC", "lines": ["見つけたぁ！！！"] },
            { "who": "meina", "lines": ["痛\"っ！", "あ～～～もう！！なんなの！！！"] },
            { "who": "lamyNPC", "lines": ["お前っ！！", "あたしにご飯を作れっ！！"] },
            { "who": "meina", "lines": ["・・・・・・・・・・・・・・・・・・・💢💢💢"] },
            { "who": "lamyNPC", "lines": ["・・・・・・・・・・・・・・・・・・・泣泣泣"] }
          ]
        },
        { "type": "portrait", "slot": "left", "hide": true },
        { "type": "portrait", "slot": "right", "hide": true },
        { "type": "portrait", "slot": "scene", "image": "20250603.jpg" },
        { "type": "cameraFollow", "on": false },
        { "type": "place", "target": "player", "at": { "x": -8, "y": 0, "z": -3 }, "face": "right" },
        {
          "type": "place",
          "target": "npc:lamyNPC",
          "at": { "x": -5, "y": 0, "z": -3 },
          "face": "left"
        },
        {
          "type": "stepInPlace",
          "target": "npc:lamyNPC",
          "steps": 4,
          "wait": false,
          "always": true
        },
        {
          "type": "message",
          "talk": [
            { "who": "lamyNPC", "lines": ["お願い、あたしが悪かったからご飯恵んでよぉ・・・。"] },
            {
              "who": "meina",
              "lines": ["（・・・そういえば、よく考えたら先に攻撃したの私か）", "", "分かったよ、何食べる？", "あ、鶏はダメだからね。"]
            }
          ]
        },
        { "type": "fade", "to": "out", "ms": 400 },
        { "type": "portrait", "slot": "scene", "hide": true },
        { "type": "portrait", "slot": "left", "who": "lamyNPC", "face": "talk", "instant": true },
        { "type": "portrait", "slot": "right", "who": "meina", "face": "talk", "instant": true },
        { "type": "time", "to": "evening ", "clock": "stop", "ms": 0 },
        { "type": "wait", "ms": 300 },
        { "type": "fade", "to": "in", "ms": 400 },
        { "type": "shot", "id": "pan01", "wait": false },
        {
          "type": "message",
          "talk": [
            { "who": "lamyNPC", "lines": ["もぐもぐ、もぐもぐ・・・", "ん～美味しい！"] },
            { "who": "meina", "lines": ["お～い、少しは遠慮したらどうなのよ？"] },
            { "who": "lamyNPC", "lines": ["こんな美味しいご飯食べたのは生まれて初めて！", "もう美味しくて美味しくて！！"] },
            {
              "who": "meina",
              "lines": ["くっ・・・悪い気がしない・・・。", "まあ、あんたの口に合ったなら良かったよ。", "", "そういえば名前は？", "あたしはメイナ"]
            },
            { "who": "lamyNPC", "lines": ["名前は無いから好きに呼んで！"] },
            { "who": "meina", "lines": ["ふ～ん、じゃあラミィって呼ぶね。"] }
          ]
        },
        { "type": "fade", "to": "out", "ms": 400 },
        { "type": "portrait", "slot": "left", "who": "lamy", "face": "talk", "from": "none" },
        {
          "type": "place",
          "target": "npc:grandpaNpc",
          "at": { "x": -7, "y": 0, "z": 0 },
          "face": "right"
        },
        { "type": "time", "to": "night", "clock": "stop", "ms": 0 },
        { "type": "fade", "to": "in", "ms": 400 },
        { "type": "wait", "ms": 300 },
        {
          "type": "portrait",
          "slot": "center",
          "who": "grandpa",
          "face": "normal",
          "x": 20,
          "from": "right"
        },
        {
          "type": "message",
          "talk": [
            { "who": "grandpa", "lines": ["帰ってきたと思ったら", "ラミアを連れてくるとはたまげたわい"] },
            { "who": "grandpa", "lines": ["それにしてもよく食べるのぉ", "よほど腹減ってたんじゃな"] },
            { "who": "lamy", "lines": ["もぐも・・・鶏がしゃべった！？"] },
            { "who": "meina", "lines": ["あんたも蛇なのにしゃべってるじゃん？"] },
            { "who": "lamy", "lines": ["もぐもぐ・・・それもそうね（？）", "", "じゅるり"] },
            { "who": "grandpa", "lines": ["やめておけ、ワシはまずいぞ"] }
          ]
        },
        { "type": "fade", "to": "out", "ms": 400 },
        { "type": "place", "target": "npc:grandpaNpc", "at": { "x": -1, "y": 0, "z": -1 } },
        { "type": "portrait", "slot": "center", "hide": true, "from": "left", "who": "grandpa" },
        { "type": "wait", "ms": 300 },
        { "type": "fade", "to": "in", "ms": 400 },
        { "type": "stepInPlace", "target": "npc:lamyNPC", "steps": 4, "stop": true, "wait": false },
        {
          "type": "message",
          "talk": [
            { "who": "lamy", "lines": ["ご馳走様！あ～～～お腹いっぱい！！"] },
            { "who": "meina", "lines": ["私の分まで全部・・・"] },
            { "who": "lamy", "lines": ["いや～なかなか美味しかった～", "また作ってよね！"] },
            {
              "who": "meina",
              "lines": ["あんたねぇ・・・", "食べた分はちゃんと返してもらうからね。", "明日デカいのを狩りに行くから付き合ってもらうよ！"]
            },
            { "who": "lamy", "lines": ["まかしとけって！", "あたしめっちゃ強いから期待しといてよ！！☆彡"] },
            { "who": "meina", "lines": ["（私より弱いくせに・・・なんか不安だ・・・。）"] }
          ]
        },
        { "type": "portrait", "slot": "left", "hide": true },
        { "type": "portrait", "slot": "right", "hide": true },
        { "type": "time", "to": "morning ", "clock": "run", "ms": 0 },
        { "type": "telop", "lines": ["━ 翌朝 ━"], "click": false },
        { "type": "portrait", "slot": "right", "who": "meina", "face": "talk" },
        { "type": "portrait", "slot": "left", "who": "lamy", "face": "talk" },
        {
          "type": "message",
          "talk": [
            { "who": "meina", "lines": ["よし、それじゃあ狩に行くよ！"] },
            { "who": "lamy", "lines": ["お～！腕が鳴るね！"] }
          ]
        },
        { "type": "telop", "lines": ["ラミィが仲間になった！！"], "dim": 0.5, "click": false, "hold": 1000 },
        { "type": "party", "op": "join", "who": "lamy" },
        {
          "type": "message",
          "talk": [{ "who": "meina", "lines": ["ラミィと会った場所から更に東に洞窟があるから", "そこでデカいのを狩ろう。"] }]
        },
        { "type": "portrait", "slot": "left", "hide": true },
        { "type": "portrait", "slot": "right", "hide": true },
        { "type": "hide", "target": "npc:lamyNPC" },
        { "type": "story", "done": "lamy_visits" }
      ],
      "kind": "scenario"
    },
    {
